# ============================================================
# Puppet Video Automation Pipeline - Configuration
# ============================================================

# ---------- Environment ----------
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---------- Project Paths ----------
PROJECT_ROOT=C:/Users/Administrator/Desktop/AE-Knowledge-Vault/puppet-automation
DATA_DIR=${PROJECT_ROOT}/data
INPUT_DIR=${DATA_DIR}/input
OUTPUT_DIR=${DATA_DIR}/output
TEMP_DIR=${DATA_DIR}/temp
CACHE_DIR=${DATA_DIR}/cache
PROJECTS_DIR=${DATA_DIR}/projects
LOGS_DIR=${PROJECT_ROOT}/logs

# ---------- API Server ----------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ---------- Redis (Celery Broker) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------- Database (SQLite for dev, PostgreSQL for prod) ----------
DATABASE_URL=sqlite:///./data/puppet_automation.db
# DATABASE_URL=postgresql+asyncpg://puppet:puppet@localhost:5432/puppet_automation

# ---------- Engine Paths ----------
AE_2026_PATH=C:/Program Files/Adobe/Adobe After Effects 2026
AE_2025_PATH=C:/Program Files/Adobe/Adobe After Effects 2025
AERENDER_PATH=C:/Program Files/Adobe/Adobe After Effects 2026/Support Files/aerender.exe
SILHOUETTE_PATH=C:/Program Files/BorisFX/Silhouette 2026.0
DAVINCI_PATH=C:/Program Files/Blackmagic Design/DaVinci Resolve
TOPAZ_PATH=D:/top/Topaz Video AI Pro/Topaz Video AI BETA.exe
BLENDER_PATH=C:/Program Files/Blender Foundation/Blender/blender.exe
FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe

# ---------- MCP Gateway ----------
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=3000
MCP_AUTH_TOKEN=change-me-in-production

# ---------- GPU ----------
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ---------- AI Models ----------
MODEL_CACHE_DIR=${CACHE_DIR}/models
HUGGINGFACE_HOME=${CACHE_DIR}/huggingface

# ---------- Monitoring ----------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
FLOWER_PORT=5555

# ---------- Webhook 告警通知 ----------
# 敏感字段通过环境变量注入：AEKV_WEBHOOK_URL / AEKV_WEBHOOK_SECRET
# 平台支持：wechat（企业微信）/ dingtalk（钉钉）/ feishu（飞书）
WEBHOOK_ENABLED=false
WEBHOOK_PLATFORM=wechat
# 完整 webhook URL，例如：
#   企业微信: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   钉钉:     https://oapi.dingtalk.com/robot/send?access_token=xxx
#   飞书:     https://open.feishu.cn/open-apis/bot/v2/hook/xxx
AEKV_WEBHOOK_URL=
# 钉钉加签密钥（可选，仅当机器人启用加签时填写）
AEKV_WEBHOOK_SECRET=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_INTERVAL=5.0
WEBHOOK_TIMEOUT=10.0
# 同一告警类型静默期（分钟），避免告警风暴
WEBHOOK_QUIET_MINUTES=5

# 持续阈值告警配置（资源持续超过阈值指定秒数后触发 webhook）
ALERT_CPU_THRESHOLD=90.0
ALERT_CPU_SUSTAINED_SECONDS=30
ALERT_MEMORY_THRESHOLD=90.0
ALERT_MEMORY_SUSTAINED_SECONDS=30
ALERT_DISK_THRESHOLD=95.0
ALERT_DISK_SUSTAINED_SECONDS=60
# 告警消息中显示的主机名，空则自动探测
ALERT_HOSTNAME=

# ---------- LLM (Optional) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini
