  "animation_recipes": {
    "bounce_in": {
      "desc": "弹性缩放入场",
      "keyframes": [
        {"t": 0.00, "scale": [0, 0], "opacity": 0},
        {"t": 0.12, "scale": [108, 108], "opacity": 100},
        {"t": 0.35, "scale": [98, 98], "opacity": 100},
        {"t": 0.50, "scale": [100, 100], "opacity": 100}
      ],
      "best_with": ["hero_*", "section_*", "sub_*"]
    },
    "tracking_fade": {
      "desc": "字距淡入",
      "expression": "var td=value;td.tracking=linear(time-thisProperty.propertyGroup(3).startTime,0,0.5,30,0);td;",
      "best_with": ["hero_cn_brutal", "section_cn_modern", "credit_*"]
    },
    "glitch_pop": {
      "desc": "故障弹出",
      "keyframes": [
        {"t": 0.00, "scale": [110, 110], "opacity": 100, "x_shift": 8},
        {"t": 0.05, "scale": [100, 100], "opacity": 100, "x_shift": -8},
        {"t": 0.10, "scale": [105, 105], "opacity": 100, "x_shift": 4},
        {"t": 0.15, "scale": [100, 100], "opacity": 100, "x_shift": 0}
      ],
      "best_with": ["sub_cyber_pixel", "sub_en_impact", "data_*"]
    },
    "typewriter": {
      "desc": "打字机效果",
      "expression": "text.sourceText=text.sourceText.substr(0,Math.floor((time-thisProperty.propertyGroup(3).startTime)*15));",
      "best_with": ["data_*", "credit_*"]
    },
    "kinetic_smash": {
      "desc": "动能撞击",
      "keyframes": [
        {"t": 0.00, "scale": [200, 200], "opacity": 0, "rotation": -8},
        {"t": 0.18, "scale": [100, 100], "opacity": 100, "rotation": 0},
        {"t": 0.30, "scale": [108, 108], "opacity": 100, "rotation": 0},
        {"t": 0.40, "scale": [100, 100], "opacity": 100, "rotation": 0}
      ],
      "best_with": ["hero_*", "sub_en_impact", "sub_cn_impact"]
    }
  },

  "fix_rules": {
    "extend_script_es3": {
      "must_use": "PostScript字体名（不是文件名）",
