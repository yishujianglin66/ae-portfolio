# AE-Knowledge-Vault 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件已在 .gitignore 中，不会被提交到代码仓库

# ========== 环境配置 ==========
# 环境类型: development / test / production
AEK_ENVIRONMENT=development

# ========== API 服务 ==========
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=*

# ========== 认证 (JWT) ==========
AE_VAULT_SECRET_KEY=ae-knowledge-vault-secret-key-please-change-in-production
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800

# ========== 数据库 ==========
DB_PATH=data/ae_vault.db

# ========== 监控 ==========
METRICS_INTERVAL=15.0
ALERT_CHECK_INTERVAL=10.0

# ========== 任务调度 ==========
SCHEDULER_WORKERS=3

# ========== 日志 ==========
LOG_LEVEL=INFO

# ========== Docker 部署 ==========
EXPOSE_PORT=80

# ========== 路径配置（可选，覆盖默认路径） ==========
# AEK_VIDEO_LIBRARY=D:/AE-Work/视频素材库
# AEK_AUDIO_LIBRARY=D:/AE-Work/音频素材库
# AEK_BGM_LIBRARY=D:/AE-Work/音频素材库/BGM
# AEK_DOWNLOAD_TEMP=D:/AE-Work/临时下载

# ---------- Adobe 全家桶路径 ----------
# AE 2025 (必须使用 25.3 版本，AE 2026 不兼容)
# AEK_AE_2025_PATH=C:/Program Files/Adobe/Adobe After Effects 2025

# Adobe Media Encoder
# AEK_MEDIA_ENCODER_PATH=D:/Me/Adobe Media Encoder 2025/Adobe Media Encoder.exe

# Adobe Premiere Pro（剪辑节奏 + 动态链接）
# AEK_PREMIERE_PATH=C:/Program Files/Adobe/Adobe Premiere Pro 2025/Adobe Premiere Pro.exe

# Adobe Photoshop（素材预处理 + PSD分层 + LUT生成）
# AEK_PHOTOSHOP_PATH=C:/Program Files/Adobe/Adobe Photoshop 2025/Photoshop.exe

# Adobe Audition（AI降噪 + 响度统一 + 音频修复）
# AEK_AUDITION_PATH=C:/Program Files/Adobe/Adobe Audition 2025/Adobe Audition.exe

# ---------- 其他专业软件路径 ----------
# AEK_SILHOUETTE_PATH=C:/Program Files/BorisFX/Silhouette 2026.0
# AEK_DAVINCI_PATH=D:/DaVinci Resolve
# AEK_TOPAZ_PATH=D:/top/Topaz Video AI Pro/Topaz Video AI BETA.exe
# AEK_BLENDER_PATH=D:/Blender/Blender 5.1.0/blender.exe
# AEK_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# AEK_FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# ========== 平台凭证 ==========
# 抖音 Cookie（直接传入 cookie 字符串，优先于 cookie 文件）
DOUYIN_COOKIE=

# 抖音 Cookie 文件路径（Netscape 格式）
DOUYIN_COOKIE_PATH=D:/AE-Work/cookies/douyin_cookies.txt

# Bilibili Cookie
BILIBILI_COOKIE=

# YouTube API Key
YOUTUBE_API_KEY=

# Pexels API Key
PEXELS_API_KEY=

# Pixabay API Key
PIXABAY_API_KEY=

# Jamendo API Key
JAMENDO_CLIENT_ID=

# ========== MCP Bridge 安全配置 ==========
# MCP Bridge 命令签名密钥（用于 HMAC-SHA256 签名验证）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
MCP_BRIDGE_SECRET=

# ========== MCP Bridge 路径配置 ==========
# AE MCP Bridge 目录（默认项目根/.ae-mcp-bridge/）
# AEK_AE_BRIDGE_DIR=

# Premiere MCP Bridge 目录（默认项目根/.pr-mcp-bridge/）
# AEK_PR_BRIDGE_DIR=

# Photoshop MCP Bridge 目录（默认项目根/.ps-mcp-bridge/）
# AEK_PS_BRIDGE_DIR=

# Audition MCP Bridge 目录（默认项目根/.au-mcp-bridge/）
# AEK_AU_BRIDGE_DIR=

# ========== MCP Bridge 运行配置 ==========
# 命令超时时间（秒）
# AEK_BRIDGE_TIMEOUT=15

# 轮询间隔（秒，越小响应越快但CPU占用越高）
# AEK_BRIDGE_POLL_INTERVAL=0.3

# 是否启用签名验证（生产环境建议启用）
# AEK_BRIDGE_SIGNATURE_ENABLED=false

# ========== LLM 网关配置 (OmniRoute / OpenAI 兼容) ==========
# OmniRoute 网关地址（默认本地）或任意 OpenAI 兼容端点
# OmniRoute: https://github.com/diegosouzapw/OmniRoute
# AEKV_LLM_BASE_URL=http://localhost:5273/v1
# 也可使用 OPENAI_BASE_URL 环境变量
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM API Key
# AEKV_LLM_API_KEY=your-api-key
# 也可使用 OPENAI_API_KEY 环境变量
# OPENAI_API_KEY=sk-xxxx

# 默认模型（auto 让 OmniRoute 自动路由，或指定具体模型）
# AEKV_LLM_MODEL=auto

# 降级 Provider 列表 (JSON 格式)
# AEKV_LLM_FALLBACKS=[{"base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx"}]

# ========== 代理配置（可选） ==========
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
