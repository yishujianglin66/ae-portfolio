# 复制为 .env 后按需修改。变量名即 pydantic-settings 字段名。
APP_NAME=FastAPI Skeleton
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
# 逗号分隔的 CORS 来源；生产请收紧，不要用 *
APP_CORS_ORIGINS=*

# 默认 SQLite 文件库（零配置）
APP_DATABASE_URL=sqlite+aiosqlite:///./app.db
# 换 Postgres 示例：
# APP_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/appdb
